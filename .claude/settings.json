{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "tmux",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(gh label create:*)",
      "Bash(gh label:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(./gradlew test:*)",
      "Bash(timeout 60 ./gradlew test:*)",
      "Bash(tee:*)",
      "Bash(pkill:*)",
      "Bash(./gradlew compileTestJava:*)",
      "Bash(unzip:*)",
      "Bash(./gradlew compileJava:*)",
      "Bash(docker exec:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(./gradlew clean build:*)",
      "Bash(git restore:*)",
      "Bash(git commit:*)",
      "Bash(python3:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Please check Claude code input\" with title \"User Decision Required\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Agent task completed successfully\" with title \"Claude\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Subagent task completed successfully\" with title \"Claude\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "context7",
    "github"
  ]
}
